HOST=0.0.0.0
PORT=21080
SRS_NATMAP_STATE_FILE=/var/lib/webrtc-live/srs-natmap.json
LIVEKIT_NATMAP_STATE_FILE=/var/lib/webrtc-live/livekit-natmap.json
ROOMS_STATE_FILE=/var/lib/webrtc-live/rooms.json
UPLOAD_DIR=/var/lib/webrtc-live/uploads
SRS_API_ORIGIN=http://srs:1985
SRS_HTTP_ORIGIN=http://srs:8080
SRS_CANDIDATE=your-public-host.example:8003
SRS_CONF_DIR=./conf

# Optional LiveKit voice feature. Leave these empty for an SRS-only setup.
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VOICE_MODERATOR_TOKEN=

# Optional Vite development proxy target. Leave unset for the local API.
# VITE_BACKEND_ORIGIN=http://127.0.0.1:21080
