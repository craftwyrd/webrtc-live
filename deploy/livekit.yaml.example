port: 7880

rtc:
  tcp_port: 7881
  udp_port: 7882
  port_range_start: 50000
  port_range_end: 50100
  use_external_ip: true

redis:
  address: redis:6379

# Replace these test values before exposing the service publicly.
keys:
  replace-with-your-api-key: replace-with-a-long-random-secret

logging:
  level: info
