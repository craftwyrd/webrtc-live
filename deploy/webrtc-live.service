[Unit]
Description=WebRTC live frontend service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/webrtc-live
EnvironmentFile=/etc/webrtc-live/webrtc-live.env
ExecStart=/usr/bin/node /opt/webrtc-live/server/app.js
Restart=on-failure
RestartSec=3
StateDirectory=webrtc-live
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/webrtc-live

[Install]
WantedBy=multi-user.target
