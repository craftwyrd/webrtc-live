<Window x:Class="CraftWyrd.DanmuOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="直播弹幕"
        Width="430"
        Height="540"
        MinWidth="320"
        MinHeight="240"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None">
  <Window.Resources>
    <SolidColorBrush x:Key="MessageBackgroundBrush" Color="#5A151718" />
  </Window.Resources>

  <Grid Margin="8">
    <Border x:Name="Surface"
            Background="#8A111314"
            BorderBrush="#667E817D"
            BorderThickness="1"
            CornerRadius="7">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="EditChrome"
              Grid.Row="0"
              Height="52"
              Margin="14,5,8,0"
              Background="Transparent"
              MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Border Width="4" Height="24" Margin="0,0,11,0" Background="{StaticResource AccentBrush}" CornerRadius="2" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock FontSize="13" FontWeight="SemiBold" Text="直播弹幕" />
            <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
              <Ellipse x:Name="StatusDot" Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" Fill="#FFF2B84B" />
              <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" FontSize="10" Text="正在连接" />
              <TextBlock Margin="7,0,0,0" Foreground="#737772" FontSize="10" Text="Ctrl + Shift + F10" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Margin="0,0,6,0" Padding="10,6" Click="LockButton_Click" ToolTip="锁定并开启鼠标穿透">锁定</Button>
            <Button Width="31" Height="31" Padding="0" Click="HideButton_Click" ToolTip="隐藏到托盘">×</Button>
          </StackPanel>
        </Grid>

        <Border x:Name="SettingsPanel"
                Grid.Row="1"
                Margin="14,3,14,8"
                Padding="12"
                Background="#AD1B1E1F"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="6">
          <StackPanel>
            <TextBlock Margin="0,0,0,6" Foreground="{StaticResource MutedBrush}" FontSize="10" Text="服务器地址" />
            <TextBox x:Name="ServerUrlBox" Margin="0,0,0,9" Text="https://srs.drivod.top" />

            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Margin="0,0,0,5" Foreground="{StaticResource MutedBrush}" FontSize="10" Text="应用名" />
                <TextBox x:Name="AppBox" Text="live" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Margin="0,0,0,5" Foreground="{StaticResource MutedBrush}" FontSize="10" Text="流名称" />
                <TextBox x:Name="StreamBox" Text="livestream" />
              </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,7">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="42" />
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="10" Text="背景透明度" />
              <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="8" Maximum="90" Value="28" ValueChanged="OpacitySlider_ValueChanged" />
              <TextBlock x:Name="OpacityValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Text="28%" />
            </Grid>

            <Grid Margin="0,0,0,7">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="42" />
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="10" Text="弹幕字号" />
              <Slider x:Name="FontSizeSlider" Grid.Column="1" Minimum="13" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" Value="17" ValueChanged="FontSizeSlider_ValueChanged" />
              <TextBlock x:Name="FontSizeValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Text="17" />
            </Grid>

            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="42" />
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="10" Text="保留条数" />
              <Slider x:Name="MessageLimitSlider" Grid.Column="1" Minimum="3" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True" Value="8" ValueChanged="MessageLimitSlider_ValueChanged" />
              <TextBlock x:Name="MessageLimitValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Text="8" />
            </Grid>

            <Grid>
              <CheckBox x:Name="TopmostCheckBox" VerticalAlignment="Center" Content="始终置顶" IsChecked="True" />
              <Button HorizontalAlignment="Right" Padding="15,7" Background="#E6D74C39" BorderBrush="#FFFF806C" Click="ApplyButton_Click">保存并连接</Button>
            </Grid>
          </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="10,0,10,10">
          <TextBlock x:Name="EmptyState"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="#99C4C3BC"
                     FontSize="12"
                     Text="等待房间里的新消息" />
          <ScrollViewer x:Name="MessagesScroller"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Hidden">
            <ItemsControl x:Name="MessagesList" ItemsSource="{Binding Messages}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,7"
                          Padding="11,9,12,10"
                          Background="{DynamicResource MessageBackgroundBrush}"
                          BorderBrush="#486E716E"
                          BorderThickness="1"
                          CornerRadius="6"
                          Opacity="0">
                    <Border.Triggers>
                      <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                          <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
                          </Storyboard>
                        </BeginStoryboard>
                      </EventTrigger>
                    </Border.Triggers>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Width="3" Background="{Binding AccentBrush}" CornerRadius="2" />
                      <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <DockPanel Margin="0,0,0,3">
                          <TextBlock DockPanel.Dock="Right" Foreground="#809D9F9A" FontSize="9" Text="{Binding Time}" />
                          <TextBlock Foreground="{Binding AccentBrush}" FontSize="11" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock FontSize="{Binding FontSize}"
                                   FontWeight="Medium"
                                   LineHeight="{Binding LineHeight}"
                                   Text="{Binding Text}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Border>

    <Thumb x:Name="ResizeGrip"
           Width="20"
           Height="20"
           HorizontalAlignment="Right"
           VerticalAlignment="Bottom"
           Cursor="SizeNWSE"
           DragDelta="ResizeGrip_DragDelta">
      <Thumb.Template>
        <ControlTemplate TargetType="Thumb">
          <Grid Background="Transparent">
            <Path HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="0,0,3,3"
                  Data="M 0 10 L 10 0 M 5 10 L 10 5"
                  Stroke="#A0F5F3ED"
                  StrokeThickness="1.5" />
          </Grid>
        </ControlTemplate>
      </Thumb.Template>
    </Thumb>
  </Grid>
</Window>
