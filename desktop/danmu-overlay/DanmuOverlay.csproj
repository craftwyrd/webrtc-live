<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CraftWyrd.DanmuOverlay</AssemblyName>
    <RootNamespace>CraftWyrd.DanmuOverlay</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="favicon.ico" LogicalName="CraftWyrd.DanmuOverlay.favicon.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3351.48" />
  </ItemGroup>
</Project>
